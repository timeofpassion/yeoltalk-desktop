{
  "name": "yeoltalk",
  "productName": "열톡",
  "version": "1.0.0",
  "description": "열정의시간 사내 메신저 열톡 — PC 프로그램",
  "author": "열정의시간",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.timeofpassion.yeoltalk",
    "productName": "열톡",
    "artifactName": "yeoltalk-setup.${ext}",
    "files": ["main.js", "preload.js", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "icon": "build/icon.png", "target": ["nsis"] },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "열톡"
    }
  }
}
